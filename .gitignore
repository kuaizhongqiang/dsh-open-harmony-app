node_modules/
dist/
*.tsbuildinfo

# ===== Python (dsh local tooling, if any) =====
__pycache__/
*.pyc
.venv/

# ===== Local secrets - exact entries only (no *.env* wildcard) =====
.env
.env.local
*.key
*.pem
*.p12
*.crt.local
# NOTE: generated CA/keystore lives under $DSH_HOME (outside repo); never commit.

# ===== HarmonyOS signing material (never commit private parts) =====
*.keystore
*.jks
*.p7b
*.cer
*.csr
signature/

# ===== OS =====
.DS_Store
Thumbs.db

# ===== Temp / scratch =====
.plan/
*.log

